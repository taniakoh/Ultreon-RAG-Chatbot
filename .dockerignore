# Dependencies
node_modules
.pnp
.pnp.js

# Next.js build output
.next
out

# Environment variables (NEVER bake these in)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git and OS junk
.git
.gitignore
.DS_Store
.claude

# Backend: exclude heavy dirs not needed in the Docker build context
backend/.venv/
backend/__pycache__/
backend/.pytest_cache/
backend/.deepeval/
backend/chroma_db/
